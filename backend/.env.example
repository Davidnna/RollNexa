# Example only. Never place real secrets in this file.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-development-secret
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set DATABASE_URL in the hosting provider's secret/environment settings.
# Example format only:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# One-time first administrator setup token; configure in Render only.
BOOTSTRAP_ADMIN_TOKEN=

# Generate a Fernet key with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_ENCRYPTION_KEY_VERSION=v1
BIOMETRIC_CONSENT_POLICY_VERSION=1.0
BIOMETRIC_FACE_MATCH_THRESHOLD=0.363
# Face model files are installed by: python backend/biometrics/download_models.py
BIOMETRIC_MODEL_DIR=biometrics/model_assets
