# Local development configuration only. Never use production secrets here.
DEBUG=True
SECRET_KEY=replace-with-a-long-random-local-development-secret
DATABASE_URL=postgresql://rollnexa:password@127.0.0.1:5432/rollnexa
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# Generate a fresh local-only Fernet key for development.
# Keep the same key for as long as local encrypted templates must remain readable.
BIOMETRIC_ENCRYPTION_KEY=
BIOMETRIC_ENCRYPTION_KEY_VERSION=v1
BIOMETRIC_CONSENT_POLICY_VERSION=1.1
BIOMETRIC_FACE_MATCH_THRESHOLD=0.363
BIOMETRIC_FACE_DETECTION_THRESHOLD=0.75
